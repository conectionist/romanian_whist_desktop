     <!-- QPlainTextEdit rather than QTextEdit: it is the widget meant for large
          append-only plain text, and a full game appends a few thousand lines.
          Read-only because nothing here is editable, and monospace because the
          log's columns are space-padded and only line up in a fixed pitch. -->
     <widget class="QPlainTextEdit" name="log">
      <property name="readOnly">
