        <file alias="10_of_clubs.png">images/cards/10_of_clubs.png</file>
        <file alias="jack_of_clubs.png">images/cards/jack_of_clubs.png</file>
        <file alias="queen_of_clubs.png">images/cards/queen_of_clubs.png</file>
