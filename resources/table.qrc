<!DOCTYPE RCC><RCC version="1.0">
    <!-- Runtime paths are :/table/<name>.png - the alias strips the source
         directory, as cards.qrc does, so moving the files does not move the URLs.

         The two table textures of the redesign (docs/ui-redesign/), generated by
         tools/generate_table_textures.py rather than drawn or photographed. PNG
         decodes without an imageformats plugin, which the deploy step strips. -->
    <qresource prefix="/table">
        <file alias="table_wood.png">images/table/table_wood.png</file>
        <file alias="table_felt.png">images/table/table_felt.png</file>
    </qresource>
</RCC>
